# HealthOS Bridge Configuration (example)
# Copy to .env and update values before running

# Enable the bridge (default: false — DISABLED by default)
# Set to 'true' only after HealthOS base URL and API key are configured
MULEMACARE_HEALTHOS_BRIDGE_ENABLED=false

# HealthOS partner API endpoint
# Example: https://api.healthos.com or https://sandbox.healthos.com
HEALTHOS_BASE_URL=

# HealthOS partner API key (HMAC-SHA256 signing key)
# Must be at least 32 characters. Store securely, never commit to git.
HEALTHOS_PARTNER_API_KEY=

# Request timeout in milliseconds (default 5000)
# Minimum: 1000, Maximum: 30000
HEALTHOS_TIMEOUT_MS=5000

# Only this tenant can call the HealthOS bridge
# Default: 'mulemacare' (safeguard against multi-tenant data leakage)
HEALTHOS_PILOT_TENANT=mulemacare

# Redis URL for nonce anti-replay cache (required if bridge enabled)
# Format: redis://host:port/db
# Local development: redis://localhost:6379/0
# Docker Compose: redis://mulemacare-redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Other existing configs
DATABASE_URL=sqlite+aiosqlite:///./mulemacare_os.db
JWT_SECRET=your-secret-key-minimum-32-characters
ENVIRONMENT=development
