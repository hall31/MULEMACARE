# MulemaCare Mutuelle OS — Environment Template
# Copy to .env and populate with actual values

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./mulemacare_os.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mulemacare_os

# JWT Authentication (REQUIRED in prod, min 32 chars)
JWT_SECRET=your-secure-32-character-minimum-jwt-secret-here-change-me

# JWT expiration (minutes, default 24 hours)
JWT_TTL_MINUTES=1440

# MCare chat flag (default: false)
MCARE_ENABLED=false

# Stripe API (optional, blank disables Stripe)
STRIPE_SECRET_KEY=sk_test_xxx

# CORS whitelist (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://mulemacare.com,https://app.mulemacare.com

# HealthOS bridge (default: false, requires secrets)
MULEMACARE_HEALTHOS_BRIDGE_ENABLED=false
HEALTHOS_BASE_URL=https://healthos.example.org
HEALTHOS_PARTNER_API_KEY=
HEALTHOS_TIMEOUT_MS=2500

# Encryption at-rest (Fernet key, 44 chars base64)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here-44-chars-base64

# Logging (optional)
LOG_LEVEL=INFO
