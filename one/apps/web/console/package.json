{
  "name": "@mulemacare-one/console",
  "private": true,
  "version": "0.0.0",
  "description": "Console gestionnaire et médecin-conseil (lot L6)",
  "type": "module",
  "scripts": {
    "dev": "NEXT_PUBLIC_API_MOCKING=enabled next dev --port 3416",
    "build": "next build",
    "build:mock": "NEXT_PUBLIC_API_MOCKING=enabled next build",
    "start": "next start --port 3416",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../../../specs/openapi.yaml --output src/api/schema.d.ts",
    "mock:worker": "msw init public --no-save"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "next": "16.3.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
