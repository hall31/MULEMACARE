{
  "name": "@mulemacare-one/partner",
  "private": true,
  "version": "0.0.0",
  "description": "Espaces assureur et employeur : agrégats k-anonymes, échéances, export CSV agrégé (Phase 3, voie B)",
  "type": "module",
  "scripts": {
    "dev": "NEXT_PUBLIC_API_MOCKING=enabled next dev --port 3420",
    "build": "next build",
    "build:mock": "NEXT_PUBLIC_API_MOCKING=enabled next build",
    "start": "next start --port 3420",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "a11y": "playwright test tests/e2e/a11y.spec.ts",
    "gen:api": "openapi-typescript ../../../specs/openapi.yaml -o src/api/schema.d.ts",
    "mock:worker": "msw init public --no-save"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
