# MulemaCare One — variables de l'API (api.main). AUCUN SECRET ICI : valeurs vides ou fictives.
# Poste de dev : `make dev` génère .env.dev avec des secrets aléatoires (non versionné).
# Production : secrets injectés par le gestionnaire de secrets de l'instance (docs/DEPLOYMENT.md).
# Une variable obligatoire absente ou invalide = refus de démarrer (code de sortie 78).

# --- Instance -------------------------------------------------------------------------------
MULEMA_ENV=production                 # production (défaut) | development
MULEMA_COUNTRY=                       # CI | SN — liste blanche réseau et infra/deploy/<pays>.toml
MULEMA_HTTP_HOST=127.0.0.1            # 0.0.0.0 dans l'image
MULEMA_HTTP_PORT=8000
MULEMA_EXPOSE_DOCS=                   # 1 = /docs, /redoc, /openapi.json (refusé en production)
MULEMA_TRUSTED_PROXIES=               # IP/CIDR du mandataire inverse (X-Forwarded-For), sinon vide

# --- Base `insurance` -------------------------------------------------------------------------
# Rôle de CONNEXION membre de mulema_app ; jamais propriétaire, superutilisateur ni BYPASSRLS.
MULEMA_INSURANCE_DATABASE_URL=        # postgresql+psycopg://<connexion>:<secret>@<hôte>:5432/insurance
MULEMA_DB_APP_ROLE=mulema_app

# --- Clés de l'application (hexadécimal, 32 octets minimum : `openssl rand -hex 32`) -----------
MULEMA_CARD_KEY=                      # scellement des secrets de carte (QR)
MULEMA_METRICS_PSEUDONYM_KEY=         # empreinte pseudonyme de la mesure produit
MULEMA_METRICS_PSEUDONYM_KEY_SINCE=   # date ISO de la dernière rotation (facultatif)
MULEMA_PRODUCT_EVENTS_RETENTION_DAYS= # 180 par défaut

# --- Paiements (canaux SIMULÉS tant que le PRD §10 Q1 n'est pas tranché) ----------------------
MULEMA_PAYMENT_LINK_SECRET=           # hexadécimal, 32 octets minimum
MULEMA_PAYMENT_PUBLIC_BASE_URL=       # https://… (page publique du payeur)
MULEMA_PAYMENT_SECRET_WAVE=           # facultatif : canal activé seulement si présent
MULEMA_PAYMENT_SECRET_ORANGE_MONEY=
MULEMA_PAYMENT_SECRET_MTN_MOMO=

# --- Identité (OIDC) ------------------------------------------------------------------------
MULEMA_OIDC_ISSUER=                   # https://… émetteur exact (`iss`)
MULEMA_OIDC_AUDIENCE=                 # audience attendue (`aud`)
MULEMA_OIDC_JWKS_FILE=                # fichier JWKS monté (lecture seule)…
MULEMA_OIDC_JWKS_URL=                 # …OU URL https dont l'hôte est dans infra/egress-allowlist.txt
MULEMA_OIDC_ALGORITHMS=RS256,ES256    # sous-ensemble de RS256, ES256
MULEMA_OIDC_ORG_CLAIM=mulema_org      # revendication portant l'UUID de l'organisation One
MULEMA_OIDC_LEEWAY_SECONDS=60         # tolérance d'horloge, 0 à 300

# --- JOE (facultatif) ------------------------------------------------------------------------
MULEMA_JOE_MODEL=deterministe         # deterministe | local
MULEMA_JOE_LOCAL_URL=
MULEMA_JOE_LOCAL_MODEL=
